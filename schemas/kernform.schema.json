{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kernform:schema:project-form:v2",
  "title": "Kernform project form v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "runtime", "git"],
  "properties": {
    "schema": {"const": "kernform.project-form/v2"},
    "generator_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "requested_signatures", "capabilities"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "requested_signatures": {
          "type": "array",
          "items": {"$ref": "#/$defs/signature"},
          "minItems": 1,
          "uniqueItems": true
        },
        "resolved_signatures": {
          "type": "array",
          "items": {"$ref": "#/$defs/signature"},
          "minItems": 1,
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "uniqueItems": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_signature": {"$ref": "#/$defs/signature"}
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "initial_branch", "initial_commit", "create_remote"],
      "properties": {
        "enabled": {"type": "boolean"},
        "initial_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?!HEAD$)(?!@$)(?!-)(?!.*\\.\\.)(?!.*@\\{)(?!.*[ ~^:?*\\[\\\\])(?!.*//)(?!/)(?!.*(?:^|/)\\.)(?!.*\\.lock(?:/|$))(?!.*\\.$)(?!.*/$)[^\\u0000-\\u001f\\u007f]+$"
        },
        "initial_commit": {"const": false},
        "create_remote": {"const": false}
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "allow_prerelease", "catalog_id", "catalog_hash"],
      "properties": {
        "policy": {"const": "newest-stable-exact"},
        "allow_prerelease": {"const": false},
        "catalog_id": {"type": "string", "minLength": 1},
        "catalog_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["javascript"],
      "properties": {"javascript": {"const": "none"}}
    },
    "containers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "rootless"],
      "properties": {
        "engine": {"const": "podman"},
        "rootless": {"const": true}
      }
    }
  },
  "$defs": {
    "signature": {"enum": ["sdk", "cli", "api", "interactive-web", "daemon"]},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
